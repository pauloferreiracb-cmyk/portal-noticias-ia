---
import type { CollectionEntry } from 'astro:content';
import { resolveCapa } from '../lib/capa';
import NewsCard from './NewsCard.astro';

interface Props {
  artigo: CollectionEntry<'noticias'>;
  // hero = destaque grande à esquerda; secundaria = coluna lateral (thumb + texto lado a lado);
  // grade = grid simples abaixo (capa em cima, texto embaixo)
  variante?: 'hero' | 'secundaria' | 'grade';
  relacionados?: CollectionEntry<'noticias'>[];
}

const { artigo, variante = 'grade', relacionados = [] } = Astro.props;
const { titulo, resumo, data, tags, fonte_nome } = artigo.data;

const capa = resolveCapa(artigo);
const dataFormatada = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(data);
const categoria = tags[0];
const ehExclusivo = tags.some((t) => t.toLowerCase().includes('exclusiv'));
const href = `/noticias/${artigo.slug}`;

const TituloTag = variante === 'hero' ? 'h1' : 'h2';

const MESES_ABREV = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const dataCurta = `${String(data.getDate()).padStart(2, '0')} ${MESES_ABREV[data.getMonth()]}`;
const dataIso = data.toISOString();
---
{variante === 'grade' ? (
  <a class="card-compacto" href={href}>
    {capa && (
      <img
        src={capa.src}
        alt=""
        class="card-compacto__img"
        width="96"
        height="72"
        loading="lazy"
      />
    )}
    <div class="card-compacto__corpo">
      <div class="card-compacto__meta">
        {categoria && <span class="card-compacto__tag">{categoria}</span>}
        {categoria && <span class="card-compacto__separador"> · </span>}
        <time class="card-compacto__tempo" datetime={dataIso} data-tempo-relativo={dataIso}>{dataCurta}</time>
      </div>
      <h2 class="card-compacto__titulo">{titulo}</h2>
      <div class="card-compacto__fonte">{fonte_nome}</div>
    </div>
  </a>
) : (
<article class={`noticia-card noticia-card--${variante}`}>
  <a class="noticia-card__link" href={href}>
    {capa && (
      <div class="noticia-card__capa-wrap">
        <img
          src={capa.src}
          alt=""
          class="noticia-card__capa"
          loading={variante === 'hero' ? 'eager' : 'lazy'}
        />
        {variante === 'hero' && categoria && (
          <span class={`tag-solida ${ehExclusivo ? 'tag-solida--ciano' : ''}`}>{categoria}</span>
        )}
      </div>
    )}
    <div class="noticia-card__corpo">
      {variante !== 'hero' && categoria && <span class="tag">{categoria}</span>}
      {variante === 'hero' && !capa && categoria && <span class="tag">{categoria}</span>}
      <TituloTag class="noticia-card__titulo">{titulo}</TituloTag>
      {variante === 'hero' && <p class="noticia-card__resumo">{resumo}</p>}
      <div class="noticia-card__meta">{dataFormatada} · {fonte_nome}</div>
    </div>
  </a>

  {capa?.credito && (
    <span class="credito-foto">
      Foto: <a href={capa.credito.fotografoUrl} target="_blank" rel="noopener">{capa.credito.fotografo}</a> / Unsplash
    </span>
  )}

  {variante === 'hero' && relacionados.length > 0 && (
    <div class="relacionados-compactos">
      {relacionados.map((r) => <NewsCard artigo={r} variante="grade" />)}
    </div>
  )}
</article>
)}

<script>
  const MINUTO = 60_000;
  const HORA = 60 * MINUTO;
  const DIA = 24 * HORA;

  function rotular(diffMs: number): string | null {
    if (diffMs >= 7 * DIA) return null;
    if (diffMs < MINUTO) return 'agora';
    if (diffMs < HORA) return `há ${Math.floor(diffMs / MINUTO)} min`;
    if (diffMs < DIA) return `há ${Math.floor(diffMs / HORA)} h`;
    const dias = Math.floor(diffMs / DIA);
    return `há ${dias} ${dias === 1 ? 'dia' : 'dias'}`;
  }

  document.querySelectorAll<HTMLTimeElement>('[data-tempo-relativo]').forEach((el) => {
    const iso = el.getAttribute('data-tempo-relativo');
    if (!iso) return;
    const diff = Date.now() - new Date(iso).getTime();
    const rotulo = rotular(diff);
    if (rotulo) el.textContent = rotulo;
  });
</script>
