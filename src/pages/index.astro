---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsCard from '../components/NewsCard.astro';

export const prerender = true;

const todas = await getCollection('noticias');
const ordenadas = todas.sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());

// Bloco de destaque: hero (mais recente) + grade de 6 cards secundários (2 colunas x 3 linhas)
const [lead, ...resto] = ordenadas;
const gradeDestaque = resto.slice(0, 6);
const relacionados = resto.slice(6, 9);

// Notícias mais antigas: grid simples abaixo do bloco de destaque
const grid = resto.slice(9);

const categorias = [...new Set(ordenadas.flatMap((a) => a.data.tags))].slice(0, 6);
---
<Layout titulo="Prompt Mídia — Notícias de IA, direto ao ponto" largura="larga" faixaManchetes>
  {categorias.length > 0 && (
    <nav class="categorias">
      {categorias.map((c) => <span class="categoria-chip">{c}</span>)}
    </nav>
  )}

  {lead && (
    <div class="destaque-grid">
      <NewsCard artigo={lead} variante="hero" relacionados={relacionados} />
      <div class="grade-destaque">
        {gradeDestaque.map((artigo) => <NewsCard artigo={artigo} variante="secundaria" />)}
      </div>
    </div>
  )}

  <EmailCapture
    titulo="As notícias de IA que importam, sem enrolação"
    texto="Um resumo por semana, direto na sua caixa de entrada."
  />

  {import.meta.env.DEV && <AdSlot id="home-topo" />}

  {grid.length > 0 && (
    <section class="secao-ultimas">
      <h2 class="secao-ultimas__titulo">&gt; ÚLTIMAS</h2>
      <div class="lista-compacta">
        {grid.map((artigo) => <NewsCard artigo={artigo} variante="grade" />)}
      </div>
    </section>
  )}

  {todas.length === 0 && (
    <p>Nenhuma notícia publicada ainda. Adicione um .md em src/content/noticias/ e dê push.</p>
  )}
</Layout>
