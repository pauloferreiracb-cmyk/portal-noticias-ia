---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import AdSlot from '../components/AdSlot.astro';

export const prerender = true;

const todas = await getCollection('noticias');
const ordenadas = todas.sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
const [lead, ...resto] = ordenadas;
const grid = resto.slice(0, 11);

function capaDe(artigo: (typeof ordenadas)[number]) {
  if (artigo.data.capa) return artigo.data.capa;

  const capaIA = `/capas-ia/${artigo.slug}.png`;
  if (fs.existsSync(path.join(process.cwd(), 'public', capaIA))) return capaIA;

  const capaCarrossel = `/carrossel/${artigo.slug}/slide-1-capa.png`;
  if (fs.existsSync(path.join(process.cwd(), 'public', capaCarrossel))) return capaCarrossel;

  return null;
}

function formatarData(d: Date) {
  return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(d);
}

const categorias = [...new Set(ordenadas.flatMap((a) => a.data.tags))].slice(0, 6);
---
<Layout titulo="Prompt Mídia — Notícias de IA, direto ao ponto" largura="larga">
  {categorias.length > 0 && (
    <nav class="categorias">
      {categorias.map((c) => <span class="categoria-chip">{c}</span>)}
    </nav>
  )}

  {lead && (
    <a class="lead" href={`/noticias/${lead.slug}`}>
      <div class="lead-corpo">
        <div class="meta-topo">
          {lead.data.tags.slice(0, 2).map((t: string) => <span class="tag">{t}</span>)}
          <span class="data-fonte">{formatarData(lead.data.data)} · {lead.data.fonte_nome}</span>
        </div>
        <h1>{lead.data.titulo}</h1>
        <p>{lead.data.resumo}</p>
      </div>
      {capaDe(lead) && <img src={capaDe(lead)!} alt="" class="lead-img" />}
    </a>
  )}

  <EmailCapture
    titulo="As notícias de IA que importam, sem enrolação"
    texto="Um resumo por semana, direto na sua caixa de entrada."
  />

  <AdSlot id="home-topo" />

  <div class="grid">
    {grid.map((artigo) => (
      <a class="card-noticia" href={`/noticias/${artigo.slug}`}>
        {capaDe(artigo) && <img src={capaDe(artigo)!} alt="" class="card-img" />}
        <div class="card-corpo">
          <h2>{artigo.data.titulo}</h2>
          <p>{artigo.data.resumo}</p>
          <div class="meta">
            {artigo.data.tags.slice(0, 3).map((t: string) => <span class="tag">{t}</span>)}
            {formatarData(artigo.data.data)} · {artigo.data.fonte_nome}
          </div>
        </div>
      </a>
    ))}
  </div>

  {todas.length === 0 && (
    <p>Nenhuma notícia publicada ainda. Adicione um .md em src/content/noticias/ e dê push.</p>
  )}
</Layout>

