---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsCard from '../components/NewsCard.astro';

export const prerender = true;

const todas = await getCollection('noticias');
const ordenadas = todas.sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());

// Bloco de destaque: hero (mais recente) + 2 colunas secundárias com 3 cards cada
const [lead, ...resto] = ordenadas;
const coluna1 = resto.slice(0, 3);
const coluna2 = resto.slice(3, 6);
const relacionados = resto.slice(6, 9).map((a) => ({
  slug: a.slug,
  titulo: a.data.titulo,
  fonte_nome: a.data.fonte_nome,
}));

// Notícias mais antigas: grid simples abaixo do bloco de destaque
const grid = resto.slice(9);

const categorias = [...new Set(ordenadas.flatMap((a) => a.data.tags))].slice(0, 6);
---
<Layout titulo="Prompt Mídia — Notícias de IA, direto ao ponto" largura="larga">
  {categorias.length > 0 && (
    <nav class="categorias">
      {categorias.map((c) => <span class="categoria-chip">{c}</span>)}
    </nav>
  )}

  {lead && (
    <div class="destaque-grid">
      <NewsCard artigo={lead} variante="hero" relacionados={relacionados} />
      <div class="coluna-secundaria">
        {coluna1.map((artigo) => <NewsCard artigo={artigo} variante="secundaria" />)}
      </div>
      <div class="coluna-secundaria">
        {coluna2.map((artigo) => <NewsCard artigo={artigo} variante="secundaria" />)}
      </div>
    </div>
  )}

  <EmailCapture
    titulo="As notícias de IA que importam, sem enrolação"
    texto="Um resumo por semana, direto na sua caixa de entrada."
  />

  <AdSlot id="home-topo" />

  {grid.length > 0 && (
    <div class="grid">
      {grid.map((artigo) => <NewsCard artigo={artigo} variante="grade" />)}
    </div>
  )}

  {todas.length === 0 && (
    <p>Nenhuma notícia publicada ainda. Adicione um .md em src/content/noticias/ e dê push.</p>
  )}
</Layout>
