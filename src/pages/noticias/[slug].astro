---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import AdSlot from '../../components/AdSlot.astro';

export const prerender = true;

export async function getStaticPaths() {
  const artigos = await getCollection('noticias');
  return artigos.map((artigo) => ({
    params: { slug: artigo.slug },
    props: { artigo },
  }));
}

interface Props {
  artigo: CollectionEntry<'noticias'>;
}
const { artigo } = Astro.props;
const { Content } = await artigo.render();
const { titulo, resumo, data, tags, fonte_url, fonte_nome, capa } = artigo.data;
const dataFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(data);

function capaDoArtigo() {
  if (capa) return { src: capa, credito: null };
  const capaIA = `/capas-ia/${artigo.slug}.png`;
  if (fs.existsSync(path.join(process.cwd(), 'public', capaIA))) {
    const jsonCredito = path.join(process.cwd(), 'public', 'capas-ia', `${artigo.slug}.json`);
    const credito = fs.existsSync(jsonCredito) ? JSON.parse(fs.readFileSync(jsonCredito, 'utf-8')) : null;
    return { src: capaIA, credito };
  }
  const capaCarrossel = `/carrossel/${artigo.slug}/slide-1-capa.png`;
  if (fs.existsSync(path.join(process.cwd(), 'public', capaCarrossel))) {
    return { src: capaCarrossel, credito: null };
  }
  return null;
}
const imagemCapa = capaDoArtigo();
---
<Layout titulo={`${titulo} — Prompt Mídia`} descricao={resumo}>
  <article>
    {imagemCapa && (
      <div class="capa-artigo-wrap">
        <img src={imagemCapa.src} alt="" class="capa-artigo" />
        {imagemCapa.credito && (
          <span class="credito-foto">
            Foto: <a href={imagemCapa.credito.fotografoUrl} target="_blank" rel="noopener">{imagemCapa.credito.fotografo}</a> / Unsplash
          </span>
        )}
      </div>
    )}
    <h1>{titulo}</h1>
    <div class="meta">
      {tags.map((t: string) => <span class="tag">{t}</span>)}
      {dataFormatada}
    </div>

    <AdSlot id="artigo-topo" />

    <Content />

    <p>
      Fonte original: <a href={fonte_url} target="_blank" rel="noopener">{fonte_nome}</a>
    </p>

    <AdSlot id="artigo-fim" />

    <!-- captura de e-mail no fim do artigo -->
    <EmailCapture />
  </article>
</Layout>


