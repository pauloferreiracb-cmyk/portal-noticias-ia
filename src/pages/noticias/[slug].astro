---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import AdSlot from '../../components/AdSlot.astro';
import { resolveCapa } from '../../lib/capa';

export const prerender = true;

export async function getStaticPaths() {
  const artigos = await getCollection('noticias');
  return artigos.map((artigo) => ({
    params: { slug: artigo.slug },
    props: { artigo },
  }));
}

interface Props {
  artigo: CollectionEntry<'noticias'>;
}
const { artigo } = Astro.props;
const { Content } = await artigo.render();
const { titulo, resumo, data, tags, fonte_url, fonte_nome } = artigo.data;
const dataFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(data);

const imagemCapa = resolveCapa(artigo);
---
<Layout titulo={`${titulo} — Prompt Mídia`} descricao={resumo}>
  <article class="leitura">
    <button id="leitura-toggle" type="button" class="leitura-toggle" aria-label="Alternar tema de leitura">
      ESCURO
    </button>

    {imagemCapa && (
      <div class="capa-artigo-wrap">
        <img src={imagemCapa.src} alt="" class="capa-artigo" />
        {imagemCapa.credito && (
          <span class="credito-foto">
            Foto: <a href={imagemCapa.credito.fotografoUrl} target="_blank" rel="noopener">{imagemCapa.credito.fotografo}</a> / Unsplash
          </span>
        )}
      </div>
    )}
    <h1>{titulo}</h1>
    <div class="meta">
      {tags.map((t: string) => <span class="tag">{t}</span>)}
      {dataFormatada}
    </div>

    <AdSlot id="artigo-topo" />

    <div class="leitura-corpo">
      <Content />
    </div>

    <p class="leitura-corpo">
      Fonte original: <a href={fonte_url} target="_blank" rel="noopener">{fonte_nome}</a>
    </p>

    <AdSlot id="artigo-fim" />

    <!-- captura de e-mail no fim do artigo -->
    <EmailCapture />
  </article>
</Layout>

<script>
  const btn = document.getElementById('leitura-toggle');

  function rotulo(tema: string) {
    return tema === 'claro' ? 'ESCURO' : 'CLARO';
  }

  function aplicar(tema: string) {
    document.documentElement.setAttribute('data-theme', tema);
    if (btn) btn.textContent = rotulo(tema);
  }

  const salvo = localStorage.getItem('leitura-tema') || 'claro';
  aplicar(salvo);

  btn?.addEventListener('click', () => {
    const atual = document.documentElement.getAttribute('data-theme') === 'claro' ? 'escuro' : 'claro';
    localStorage.setItem('leitura-tema', atual);
    aplicar(atual);
  });
</script>

<style>
  .leitura {
    background: var(--leitura-bg);
    color: var(--leitura-texto);
    padding: 28px;
    max-width: 68ch;
    margin: 0 auto;
  }

  .leitura h1 {
    color: var(--leitura-titulo);
  }

  .leitura .meta {
    color: var(--leitura-meta);
    font-family: var(--fonte-mono);
  }

  .leitura-toggle {
    display: block;
    margin: 0 0 20px auto;
    padding: 8px 14px;
    border: 1px solid var(--leitura-borda);
    border-radius: 0;
    background: var(--leitura-bloco);
    color: var(--leitura-texto);
    font-family: var(--fonte-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .leitura-toggle:hover {
    color: var(--leitura-link);
    border-color: var(--leitura-link);
  }

  .leitura-corpo {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 18px;
    line-height: 1.75;
    color: var(--leitura-texto);
  }

  .leitura-corpo :global(a) {
    color: var(--leitura-link);
    text-decoration: underline;
  }

  .leitura-corpo :global(h2),
  .leitura-corpo :global(h3) {
    color: var(--leitura-titulo);
    font-family: var(--fonte-titulo);
  }

  .leitura-corpo :global(blockquote) {
    margin: 24px 0;
    padding: 14px 18px;
    background: var(--leitura-bloco);
    border-left: 3px solid var(--leitura-link);
    color: var(--leitura-texto);
  }

  .leitura-corpo :global(pre) {
    background: var(--leitura-bloco);
    border: 1px solid var(--leitura-borda);
    padding: 16px;
    overflow-x: auto;
    border-radius: 0;
  }

  .leitura-corpo :global(code) {
    font-family: var(--fonte-mono);
    font-size: 0.9em;
  }

  .leitura-corpo :global(hr) {
    border: none;
    border-top: 1px solid var(--leitura-borda);
    margin: 32px 0;
  }
</style>


