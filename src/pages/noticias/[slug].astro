---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import AdSlot from '../../components/AdSlot.astro';
import { resolveCapa } from '../../lib/capa';
import { slugify } from '../../utils/slug';

export const prerender = true;

export async function getStaticPaths() {
  const artigos = await getCollection('noticias');
  return artigos.map((artigo) => ({
    params: { slug: artigo.slug },
    props: { artigo },
  }));
}

interface Props {
  artigo: CollectionEntry<'noticias'>;
}
const { artigo } = Astro.props;
const { Content } = await artigo.render();
const { titulo, resumo, data, tags, fonte_url, fonte_nome } = artigo.data;
const dataFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Sao_Paulo',
})
  .format(data)
  .replace(/\./g, '')
  .replace(/ de /g, ' ');

const imagemCapa = resolveCapa(artigo);
---
<Layout titulo={`${titulo} — Prompt Mídia`} descricao={resumo} paginaLeitura>
  <article class="leitura">
    <button id="leitura-toggle" type="button" class="leitura-toggle" aria-label="Alternar tema de leitura">
      ESCURO
    </button>

    {imagemCapa && (
      <div class="capa-artigo-wrap">
        <img src={imagemCapa.src} alt="" class="capa-artigo" />
        {imagemCapa.credito && (
          <span class="credito-foto">
            Foto: <a href={imagemCapa.credito.fotografoUrl} target="_blank" rel="noopener">{imagemCapa.credito.fotografo}</a> / Unsplash
          </span>
        )}
      </div>
    )}
    <h1>{titulo}</h1>
    <div class="tags-artigo">
      {tags.map((t: string) => (
        <a href={`/tag/${slugify(t)}/`} class="tag-leitura">{t}</a>
      ))}
    </div>
    <div class="selo-confianca">
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="#5B8DFF" /><path d="M9 16.5 L14 21.5 L23 11" fill="none" stroke="#0B1020" stroke-width="3.6" stroke-linecap="square" /></svg>
      <span class="selo-verificado">Verificado</span>
      <span class="selo-fonte">Fonte: {fonte_nome}</span>
      <span class="selo-data">{dataFormatada}</span>
    </div>

    <div class="leitura-corpo" id="leitura-corpo">
      <Content />
    </div>

    {import.meta.env.DEV && (
      <div id="anuncio-meio-artigo" class="anuncio-leitura" hidden>
        espaço reservado para anúncio
      </div>
    )}

    <p class="leitura-corpo">
      Fonte original: <a href={fonte_url} target="_blank" rel="noopener">{fonte_nome}</a>
    </p>
    <p class="assinatura">Redação Prompt Mídia</p>

    {import.meta.env.DEV && <AdSlot id="artigo-fim" />}

    <!-- captura de e-mail no fim do artigo -->
    <EmailCapture />
  </article>
</Layout>

<script>
  const btn = document.getElementById('leitura-toggle');

  function rotulo(tema: string) {
    return tema === 'claro' ? 'ESCURO' : 'CLARO';
  }

  function aplicar(tema: string) {
    document.documentElement.setAttribute('data-theme', tema);
    if (btn) btn.textContent = rotulo(tema);
  }

  const salvo = localStorage.getItem('leitura-tema') || 'claro';
  aplicar(salvo);

  btn?.addEventListener('click', () => {
    const atual = document.documentElement.getAttribute('data-theme') === 'claro' ? 'escuro' : 'claro';
    localStorage.setItem('leitura-tema', atual);
    aplicar(atual);
  });

  const anuncio = document.getElementById('anuncio-meio-artigo');
  if (anuncio) {
    const corpo = document.getElementById('leitura-corpo');
    const paragrafos = corpo ? Array.from(corpo.children).filter((el) => el.tagName === 'P') : [];
    const alvo = paragrafos[1];
    if (alvo) {
      alvo.insertAdjacentElement('afterend', anuncio);
    } else if (corpo) {
      corpo.appendChild(anuncio);
    }
    anuncio.hidden = false;
  }
</script>

<style>
  .leitura {
    border: 3px solid var(--leitura-borda);
    background: var(--leitura-bg);
    padding: 28px;
    max-width: 68ch;
    margin: 0 auto;
  }

  .leitura h1 {
    color: var(--leitura-titulo);
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .tags-artigo {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .tag-leitura {
    display: inline-block;
    border: 2px solid var(--leitura-titulo);
    color: var(--leitura-titulo);
    font-family: var(--fonte-mono);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 10px 12px;
    line-height: 1.2;
    text-decoration: none;
  }

  .tag-leitura:hover,
  .tag-leitura:focus-visible {
    background: var(--amarelo);
    border-color: var(--tinta);
    color: var(--tinta);
    text-decoration: none;
  }

  .tag-leitura:focus-visible {
    outline: 3px solid var(--leitura-titulo);
    outline-offset: 2px;
  }

  /* selo de confiança: Verificado (azul) + Fonte + data */
  .selo-confianca {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 16px;
    font-family: var(--fonte-mono);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .selo-verificado { color: var(--azul-claro); }
  [data-theme="escuro"] .selo-verificado { color: var(--azul); }
  .selo-fonte { color: var(--leitura-meta); font-weight: 500; }
  .selo-data { color: var(--leitura-meta); margin-left: auto; white-space: nowrap; }

  .assinatura {
    margin: 28px 0 0;
    padding-top: 16px;
    border-top: 3px solid var(--leitura-borda);
    font-family: var(--fonte-mono);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--leitura-titulo);
  }

  .anuncio-leitura {
    min-height: 100px;
    border: 2px dashed var(--leitura-meta);
    border-radius: 0;
    background: var(--leitura-bloco);
    color: var(--leitura-meta);
    font-family: var(--fonte-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 24px 0;
  }

  .leitura-toggle {
    display: block;
    margin: 0 0 20px auto;
    padding: 8px 14px;
    border: 2px solid var(--leitura-titulo);
    border-radius: 0;
    background: var(--leitura-bloco);
    color: var(--leitura-texto);
    font-family: var(--fonte-mono);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .leitura-toggle:hover {
    background: var(--amarelo);
    color: var(--tinta);
    border-color: var(--tinta);
  }

  .leitura-corpo {
    font-family: var(--fonte);
    font-size: 21px;
    line-height: 1.6;
    color: var(--leitura-texto);
  }

  .leitura-corpo :global(a) {
    color: var(--leitura-link);
    text-decoration: underline;
  }

  .leitura-corpo :global(h2),
  .leitura-corpo :global(h3) {
    color: var(--leitura-titulo);
    font-family: var(--fonte-titulo);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .leitura-corpo :global(blockquote) {
    margin: 24px 0;
    padding: 14px 18px;
    background: var(--leitura-bloco);
    border-left: 6px solid var(--amarelo);
    color: var(--leitura-texto);
  }

  .leitura-corpo :global(pre) {
    background: var(--leitura-bloco);
    border: 2px solid var(--leitura-titulo);
    padding: 16px;
    overflow-x: auto;
    border-radius: 0;
  }

  .leitura-corpo :global(code) {
    font-family: var(--fonte-mono);
    font-size: 0.9em;
  }

  .leitura-corpo :global(hr) {
    border: none;
    border-top: 3px solid var(--leitura-borda);
    margin: 32px 0;
  }
</style>


