---
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao?: string;
  largura?: 'normal' | 'larga';
}
const { titulo, descricao = 'Notícias de IA, direto ao ponto.', largura = 'normal' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var tema = localStorage.getItem('leitura-tema') || 'claro';
          document.documentElement.setAttribute('data-theme', tema);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'claro');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Tipografia da identidade (Space Grotesk / Inter / JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div class={`container ${largura === 'larga' ? 'largo' : ''}`}>
      <header class="cabecalho">
        <a href="/" class="logo"><span class="cursor">&gt;_</span>PROMPT<span class="midia"> MÍDIA</span></a>
        <nav>
          <a href="/links">Links</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="rodape">
        <span>© {new Date().getFullYear()} Prompt Mídia</span>
        <a href="/links">todos os links</a>
      </footer>
    </div>

    <script>
      import { capturarUTM, propagarUTMEmLinksInternos } from '../lib/utm';
      capturarUTM();
      propagarUTMEmLinksInternos();
    </script>

    <!-- Vercel Web Analytics -->
    <script type="module">
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>

